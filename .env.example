# Copy to `.env` (gitignored — never commit the real file).
# Runtime secrets for the backend API + admin panel.
#
# DEPLOY_* tooling vars are NOT here — they live in `.env.deploy.example`.
#
# This is the ONLY place the app's required variables are documented. Every
# `process.env.*` read in app/, prisma/ and scripts/ is listed below.

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Use the :5432 form on purpose.
#
# app/lib/prisma.ts (normalizeDatabaseUrl) rewrites ":5432/" -> ":6543/" for
# pooler.supabase.com, so the app runtime automatically uses the Supabase
# TRANSACTION pooler. That avoids EMAXCONNSESSION, which session mode hits at
# roughly 15 clients.
#
# NOTE: prisma.config.ts reads DATABASE_URL raw, with no rewrite. So
# `npm run db:migrate` and `npm run db:studio` run in SESSION mode. That is fine
# for a single connection, but it means this variable serves two purposes.
DATABASE_URL=postgresql://PROJECT_REF:YOUR_PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Optional. Defaults to 2 when the host is Supabase, otherwise 5.
# Keep it low: the transaction pooler caps concurrent connections.
DATABASE_POOL_MAX=2

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Signs access tokens. Rotating it invalidates every issued token.
JWT_SECRET=

# REQUIRED. Signs refresh tokens. Rotating it logs every client out on all devices.
REFRESH_TOKEN_SECRET=

# REQUIRED to bootstrap an admin account. Generate with: openssl rand -hex 32
ADMIN_CREATION_SECRET=

# ── Customer OTP (Phase A — customer account configuration) ─────────────────
# Set to 1/true to skip live SMS/email. Accepts OTP_DEV_CODE (default 123456)
# and returns `devCode` in send responses for local/staging.
OTP_DEV_MODE=1
OTP_DEV_CODE=123456

# Mobile SMS via 2factor.in (required when OTP_DEV_MODE is off).
TWOFACTOR_API_KEY=
# Optional. Defaults to https://2factor.in/API/V1
TWOFACTOR_BASE_URL=
# Optional template / sender id if your 2factor account requires it.
TWOFACTOR_TEMPLATE=

# Email OTP provider TBD (Resend / SES / SendGrid / Postmark).
# Until chosen, email OTP only works with OTP_DEV_MODE=1.
EMAIL_OTP_PROVIDER=
EMAIL_OTP_API_KEY=

# GSTIN.cloud — Admin Verify GST button only (Phase B). Never call from signup/OTP.
# GSTIN_CLOUD_DEV_MODE=1 forces mock results (also follows OTP_DEV_MODE when unset).
GSTIN_CLOUD_API_KEY=
GSTIN_CLOUD_BASE_URL=
GSTIN_CLOUD_DEV_MODE=

# ── Supabase Storage (order images) ─────────────────────────────────────────
# REQUIRED. REST endpoint of your Supabase project.
SUPABASE_URL=https://PROJECT_REF.supabase.co/rest/v1/

# REQUIRED. The service_role key BYPASSES Row Level Security — it can read and
# write every table, including customer PII. Server-only. Never prefix it with
# NEXT_PUBLIC_/EXPO_PUBLIC_. Never commit it. Rotate it if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Storage bucket for order images. Defaults to "order-images".
SUPABASE_ORDER_IMAGES_BUCKET=order-images

# Optional. PRIVATE bucket for procurement documents (supplier bills, power-wise
# receive Excel). Defaults to "procurement-documents". Created as private on
# first upload if missing; uploads are refused if the bucket is public.
SUPABASE_PROCUREMENT_BUCKET=procurement-documents

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# REQUIRED. Guards /api/cron/* endpoints.
#
# The crons FAIL CLOSED: if this is unset they return 503 rather than running
# unauthenticated. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Housekeeping ────────────────────────────────────────────────────────────
# Optional. Days to retain SystemErrorLog rows. Defaults to 90.
# AuditEvent and SecurityEvent are never purged, regardless of this value.
# Used only by: npm run audit:purge-errors
AUDIT_RETENTION_DAYS=90

# ── Seed helpers (optional) ─────────────────────────────────────────────────
# Used only by: npm run db:seed-reorder-rules
# Set REORDER_SEED_DRY_RUN=1 to report what would change without writing.
REORDER_SEED_DRY_RUN=
# Set to 0 to create reorder rules with auto procurement switched OFF.
REORDER_SEED_AUTO_PROCURE=1

# NODE_ENV is set by Next.js at build/run time — do not set it here.

enum PaymentMode {
  CASH
  UPI
  BANK
  CARD
  CHEQUE
  OTHER
  CREDIT
}

enum PaymentClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PartyLedgerEntryType {
  OPENING
  INVOICE
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  ADVANCE
  ADJUSTMENT
}

model Payment {
  id                    String                @id @default(cuid())
  paymentNumber         String                @unique
  customer              User                  @relation("CustomerPayments", fields: [customerId], references: [id])
  customerId            String
  amount                Decimal
  mode                  PaymentMode
  reference             String?
  paidAt                DateTime              @default(now())
  notes                 String?
  /// Unallocated remainder (customer advance).
  unallocatedAmount     Decimal               @default(0)
  claim                 PaymentClaim?         @relation(fields: [claimId], references: [id])
  claimId               String?               @unique
  recordedById          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  allocations           PaymentAllocation[]
  customerLedgerEntries CustomerLedgerEntry[]

  @@index([customerId, paidAt])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  invoiceId String
  amount    Decimal
  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model PaymentClaim {
  id           String             @id @default(cuid())
  customer     User               @relation("CustomerPaymentClaims", fields: [customerId], references: [id])
  customerId   String
  amount       Decimal
  mode         PaymentMode
  reference    String?
  notes        String?
  status       PaymentClaimStatus @default(PENDING)
  reviewedBy   User?              @relation("PaymentClaimReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  payment      Payment?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  items        PaymentClaimItem[]

  @@index([customerId, status])
  @@index([status, createdAt])
}

model PaymentClaimItem {
  id        String       @id @default(cuid())
  claim     PaymentClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimId   String
  invoice   Invoice      @relation(fields: [invoiceId], references: [id])
  invoiceId String
  amount    Decimal?

  @@unique([claimId, invoiceId])
}

model CustomerLedgerEntry {
  id           String               @id @default(cuid())
  customer     User                 @relation(fields: [customerId], references: [id])
  customerId   String
  entryType    PartyLedgerEntryType
  /// Positive = increases receivable (debit), negative = decreases (credit) when using signed amount.
  /// Prefer debitAmount / creditAmount for clarity.
  debitAmount  Decimal              @default(0)
  creditAmount Decimal              @default(0)
  balanceAfter Decimal?
  description  String?
  occurredAt   DateTime             @default(now())
  invoice      Invoice?             @relation(fields: [invoiceId], references: [id])
  invoiceId    String?
  payment      Payment?             @relation(fields: [paymentId], references: [id])
  paymentId    String?
  creditNote   CreditNote?          @relation(fields: [creditNoteId], references: [id])
  creditNoteId String?
  createdAt    DateTime             @default(now())

  @@index([customerId, occurredAt])
  @@index([invoiceId])
}

enum PurchaseBillStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Supplier {
  id                 String                @id @default(cuid())
  name               String
  tradeName          String?
  gstin              String?
  state              String?
  stateCode          String?
  address            String?
  phone              String?
  email              String?
  /// RW-08 Phase C supplier profile. All optional so legacy rows stay valid.
  /// PROPRIETORSHIP | PARTNERSHIP | LLP | PRIVATE_LIMITED | PUBLIC_LIMITED | OTHER
  businessEntityType String?
  contactPerson      String?
  alternatePhone     String?
  pan                String?
  city               String?
  pincode            String?
  /// Dispatch / warehouse address when different from the registered address.
  dispatchAddress    String?
  notes              String?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  purchaseBills      PurchaseBill[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  supplierPayments   SupplierPayment[]
  ledgerEntries      SupplierLedgerEntry[]
  reorderRules       ReorderRule[]

  @@index([name])
  @@index([gstin])
}

model PurchaseBill {
  id                  String                      @id @default(cuid())
  billNumber          String                      @unique
  supplierBillNumber  String?
  supplier            Supplier                    @relation(fields: [supplierId], references: [id])
  supplierId          String
  billDate            DateTime                    @default(now())
  status              PurchaseBillStatus          @default(DRAFT)
  financialYear       String?
  placeOfSupplyState  String?
  isInterState        Boolean                     @default(false)
  poReference         String?
  grnReference        String?
  mismatchWarning     String?
  grossAmount         Decimal                     @default(0)
  discountAmount      Decimal                     @default(0)
  taxableAmount       Decimal                     @default(0)
  cgstAmount          Decimal                     @default(0)
  sgstAmount          Decimal                     @default(0)
  igstAmount          Decimal                     @default(0)
  roundingAdjustment  Decimal                     @default(0)
  totalAmount         Decimal                     @default(0)
  amountPaid          Decimal                     @default(0)
  amountOutstanding   Decimal                     @default(0)
  notes               String?
  /// Private storage object path of the supplier bill document (RW-08).
  documentStoragePath String?
  documentFileName    String?
  documentMimeType    String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  lines               PurchaseBillLine[]
  paymentAllocations  SupplierPaymentAllocation[]
  ledgerEntries       SupplierLedgerEntry[]
  goodsReceipt        GoodsReceipt?

  @@index([supplierId, status])
  @@index([status, billDate])
}

model PurchaseBillLine {
  id             String       @id @default(cuid())
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  purchaseBillId String
  lineNumber     Int
  description    String
  sku            String?
  hsnCode        String?
  quantity       Decimal
  unitPrice      Decimal
  discountAmount Decimal      @default(0)
  taxableAmount  Decimal
  gstRatePercent Decimal
  cgstAmount     Decimal      @default(0)
  sgstAmount     Decimal      @default(0)
  igstAmount     Decimal      @default(0)
  lineTotal      Decimal

  @@index([purchaseBillId])
}

model SupplierPayment {
  id                String                      @id @default(cuid())
  paymentNumber     String                      @unique
  supplier          Supplier                    @relation(fields: [supplierId], references: [id])
  supplierId        String
  amount            Decimal
  mode              PaymentMode
  reference         String?
  paidAt            DateTime                    @default(now())
  notes             String?
  unallocatedAmount Decimal                     @default(0)
  recordedBy        User?                       @relation("SupplierPaymentRecorder", fields: [recordedById], references: [id])
  recordedById      String?
  createdAt         DateTime                    @default(now())
  allocations       SupplierPaymentAllocation[]
  ledgerEntries     SupplierLedgerEntry[]

  @@index([supplierId, paidAt])
}

model SupplierPaymentAllocation {
  id                String          @id @default(cuid())
  supplierPayment   SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  supplierPaymentId String
  purchaseBill      PurchaseBill    @relation(fields: [purchaseBillId], references: [id])
  purchaseBillId    String
  amount            Decimal
  createdAt         DateTime        @default(now())

  @@unique([supplierPaymentId, purchaseBillId])
}

model SupplierLedgerEntry {
  id                String               @id @default(cuid())
  supplier          Supplier             @relation(fields: [supplierId], references: [id])
  supplierId        String
  entryType         PartyLedgerEntryType
  debitAmount       Decimal              @default(0)
  creditAmount      Decimal              @default(0)
  balanceAfter      Decimal?
  description       String?
  occurredAt        DateTime             @default(now())
  purchaseBill      PurchaseBill?        @relation(fields: [purchaseBillId], references: [id])
  purchaseBillId    String?
  supplierPayment   SupplierPayment?     @relation(fields: [supplierPaymentId], references: [id])
  supplierPaymentId String?
  createdAt         DateTime             @default(now())

  @@index([supplierId, occurredAt])
}

enum CashAccountType {
  COMPANY
  EMPLOYEE_FLOAT
  BANK
}

model CashAccount {
  id              String            @id @default(cuid())
  name            String
  accountType     CashAccountType
  employee        User?             @relation("EmployeeCashAccounts", fields: [employeeId], references: [id])
  employeeId      String?
  balance         Decimal           @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ledgerEntries   CashLedgerEntry[]
  expenseRequests ExpenseRequest[]

  @@index([accountType])
  @@index([employeeId])
}

model CashLedgerEntry {
  id            String      @id @default(cuid())
  cashAccount   CashAccount @relation(fields: [cashAccountId], references: [id])
  cashAccountId String
  /// Positive = in, negative direction via outAmount
  inAmount      Decimal     @default(0)
  outAmount     Decimal     @default(0)
  balanceAfter  Decimal
  description   String?
  referenceType String?
  referenceId   String?
  occurredAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([cashAccountId, occurredAt])
}

enum ExpenseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseDocType {

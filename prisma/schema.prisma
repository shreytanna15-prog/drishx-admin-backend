// --- Loyalty (X Points) ---

/// Company-wide loyalty program policy (singleton).
model LoyaltySettings {
  id                  String   @id @default("default")
  enabled             Boolean  @default(true)
  /// Rule "1 X Point = ₹1". Always 1 in Phase 1.
  pointValue          Int      @default(1)
  /// Base earning % of net taxable value for full payment (on-time).
  baseRatePct         Decimal  @default(0.5)
  /// Extra % for full advance payment (base + advance = maximum).
  advanceBonusPct     Decimal  @default(1.0)
  /// Explicit full-payment rate (may equal base for non-advance). Kept for clarity.
  fullPaymentRatePct  Decimal  @default(0.5)
  /// Minimum protected gross margin %. Below this, no points awarded (zero-point option).
  minMarginPct        Decimal  @default(5)
  /// Max % of invoice taxable value that can be redeemed with points.
  maxRedemptionPct    Decimal  @default(5)
  /// Points expire this many days after activation.
  expiryDays          Int      @default(365)
  /// Minimum invoice taxable value required to earn points.
  minInvoiceValue     Decimal  @default(0)
  /// Max points per invoice (0 = unlimited).
  maxPointsPerInvoice Decimal  @default(0)
  /// Award points on freight/shipping/handling charges.
  freightEligible     Boolean  @default(false)
  /// Fraud guard: duplicate invoice can never earn points twice.
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

enum LoyaltyTransactionType {
  POINTS_EARNED
  ADVANCE_BONUS
  POINTS_REDEEMED
  POINTS_EXPIRED
  POINTS_REVERSED
  POINTS_ADJUSTED
  POINTS_CANCELLED
}

enum LoyaltyTransactionStatus {
  PENDING
  AVAILABLE
  REDEEMED
  EXPIRED
  REVERSED
  CANCELLED
}

/// Per-customer running totals (1:1 with User).
model LoyaltyWallet {
  id              String   @id @default(cuid())
  customer        User     @relation(fields: [customerId], references: [id])
  customerId      String   @unique
  availablePoints Decimal  @default(0)
  pendingPoints   Decimal  @default(0)
  totalEarned     Decimal  @default(0)
  totalRedeemed   Decimal  @default(0)
  totalExpired    Decimal  @default(0)
  totalReversed   Decimal  @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([customerId])
}

/// Point movement ledger. Every point has a source.
model LoyaltyTransaction {
  id              String                   @id @default(cuid())
  customer        User                     @relation(fields: [customerId], references: [id])
  customerId      String
  type            LoyaltyTransactionType
  /// Positive = earn, negative = redeem/expire/reverse.
  points          Decimal
  balanceAfter    Decimal
  status          LoyaltyTransactionStatus @default(PENDING)
  reason          String?
  invoiceId       String?
  orderId         String?
  paymentId       String?
  creditNoteId    String?
  returnRequestId String?
  /// Who created this transaction (admin manual adjust, system, staff).
  createdBy       User?                    @relation("LoyaltyCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  expiresAt       DateTime?
  activatedAt     DateTime?
  createdAt       DateTime                 @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([invoiceId])
  @@index([customerId, status])
}

enum AttendanceMethod {
  QR_SCAN
  BY_ADMIN
}

/// One office attendance day (Asia/Kolkata calendar date) with a rotating QR token.
model AttendanceDay {
  id             String             @id @default(cuid())
  /// Calendar date stored as UTC midnight of the IST day key (YYYY-MM-DD).
  date           DateTime           @db.Date
  currentToken   String
  tokenExpiresAt DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  records        AttendanceRecord[]

  @@unique([date])
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  dayId      String
  day        AttendanceDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User             @relation("AttendanceEmployee", fields: [employeeId], references: [id])
  /// Always PRESENT in v1.
  status     String           @default("PRESENT")
  method     AttendanceMethod
  markedAt   DateTime         @default(now())
  markedById String?
  markedBy   User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([employeeId, dayId])
  @@index([dayId])
  @@index([employeeId])
}

// --- Stock-wise Procurement (Reorder Rules + Procurement Requests) ---

enum ProcurementRequestSource {
  /// Created because a customer order could not be fully covered from stock (PDF §2.1).
  ORDER_SHORTAGE
  /// Created automatically because available stock fell to/below the minimum threshold (PDF §2.2).
  MINIMUM_STOCK_THRESHOLD
  /// Created by an admin/staff member by hand (PDF §2.3).
  MANUAL
}

enum ProcurementRequestStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  CANCELLED
  /// Stock fully received — the shortage is closed.
  RESOLVED
}

enum ProcurementPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/// Per SKU (= lensType + lensId) replenishment configuration.
/// `lensId` is intentionally a plain string so one table serves all six lens
/// families (SingleVision / Kryptok / Progressive / OriVision / Magnus / Bifocal).
model ReorderRule {
  id                  String    @id @default(cuid())
  lensType            LensType
  lensId              String
  /// Replenishment trigger line. Available stock at or below this raises a request.
  minStock            Int       @default(0)
  /// Desired level after replenishment. Required quantity = target - available - incoming.
  targetStock         Int
  /// When false this rule is documentation only — nothing is triggered automatically.
  autoProcure         Boolean   @default(false)
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  /// Minimum order quantity. Recommended quantity is rounded up to a MOQ multiple.
  moq                 Int?
  isActive            Boolean   @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  requests ProcurementRequest[]

  @@unique([lensType, lensId])
  @@index([lensType])
  @@index([autoProcure, isActive])
}

/// The central entity connecting inventory demand to an actual purchase.
/// Doubles as the "reorder event" record (PDF §9) — trigger reason, stock at
/// trigger, minimum, target and required quantity are all stored inline.
model ProcurementRequest {
  id       String                   @id @default(cuid())
  /// Human-facing reference, e.g. PR-000125.
  publicId String                   @unique
  lensType LensType
  lensId   String
  source   ProcurementRequestSource
  status   ProcurementRequestStatus @default(OPEN)
  priority ProcurementPriority      @default(NORMAL)

  /// Shortage that triggered this request.
  requiredQuantity  Int
  /// Quantity actually asked for (may be raised to an MOQ multiple).
  requestedQuantity Int
  orderedQuantity   Int @default(0)
  receivedQuantity  Int @default(0)

  /// Originating customer order, when source = ORDER_SHORTAGE (PDF §32).
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  reorderRuleId String?
  reorderRule   ReorderRule? @relation(fields: [reorderRuleId], references: [id], onDelete: SetNull)

  // --- Reorder event snapshot (PDF §9) ---
  stockAtTrigger       Int?
  minStockAtTrigger    Int?
  targetStockAtTrigger Int?
  availableAtTrigger   Int?
  incomingAtTrigger    Int?
  triggerReason        String?

  resolvedAt       DateTime?
  resolutionReason String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  /// Null when raised automatically by the reorder checker.
  approvedAt   DateTime?
  approvedById String?

  purchaseOrderLines       PurchaseOrderLine[]
  purchaseOrderAllocations PurchaseOrderAllocation[]

  @@index([lensType, lensId, status])
  @@index([status, source])
  @@index([orderId])
  @@index([createdAt])
}

/// Purchase Order lifecycle (RW-08 Phase A). Stock is never posted here.
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  /// Approved PO confirmed as dispatched to the supplier (email/manual).
  SENT
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id               String                    @id @default(cuid())
  /// Human-facing reference, e.g. PO-2026-000001.
  publicId         String                    @unique
  status           PurchaseOrderStatus       @default(DRAFT)
  supplierId       String
  supplier         Supplier                  @relation(fields: [supplierId], references: [id])
  /// Warehouse stub — Main today; extensible later.
  warehouseCode    String                    @default("MAIN")
  expectedDelivery DateTime?
  notes            String?
  subtotal         Decimal                   @default(0)
  totalAmount      Decimal                   @default(0)
  createdById      String?
  approvedAt       DateTime?
  approvedById     String?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelReason     String?
  /// Supplier dispatch tracking — set only on an explicit, authorized "sent" record.
  sentAt           DateTime?
  sentById         String?
  /// EMAIL | WHATSAPP | COURIER | HAND_DELIVERY | PHONE | OTHER
  sentVia          String?
  sentTo           String?
  sentNote         String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  lines            PurchaseOrderLine[]
  powerLocks       OpenPurchaseOrderPower[]
  allocations      PurchaseOrderAllocation[]
  goodsReceipts    GoodsReceipt[]

  @@index([status, createdAt])
  @@index([supplierId, status])
}

model PurchaseOrderLine {
  id                   String                    @id @default(cuid())
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder             @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNumber           Int
  lensType             LensType
  lensId               String
  productLabel         String?
  rangeLabel           String?
  powerLabel           String?
  requiredQuantity     Int
  poQuantity           Int
  rate                 Decimal?
  amount               Decimal                   @default(0)
  receivedQuantity     Int                       @default(0)
  cancelledQuantity    Int                       @default(0)
  procurementRequestId String?
  procurementRequest   ProcurementRequest?       @relation(fields: [procurementRequestId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  powerLock            OpenPurchaseOrderPower?
  allocations          PurchaseOrderAllocation[]
  goodsReceiptLines    GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNumber])
  @@index([lensType, lensId])
  @@index([procurementRequestId])
  @@index([purchaseOrderId])
}

/// Exact PR→PO line allocation created on approve only. Cancel reverses these rows.
model PurchaseOrderAllocation {
  id                   String             @id @default(cuid())
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderLineId  String
  purchaseOrderLine    PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  procurementRequestId String
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Restrict)
  quantity             Int
  /// Portion already reversed (cancel / close outstanding). Active = quantity − reversedQuantity.
  reversedQuantity     Int                @default(0)
  /// Portion received via Confirm Receipt. Never reversible.
  receivedQuantity     Int                @default(0)
  /// Set when fully reversed — prevents double-reverse of residual.
  reversedAt           DateTime?
  createdAt            DateTime           @default(now())

  @@unique([purchaseOrderLineId, procurementRequestId])
  @@index([purchaseOrderId, reversedAt])
  @@index([procurementRequestId])
}

enum GoodsReceiptStatus {
  DRAFT
  VALIDATED
  CONFIRMED
  CANCELLED
}

enum GoodsReceiptLineStatus {
  MATCHED
  SHORT
  EXTRA
  INVALID
  DAMAGED
  PENDING
}

/// Goods receipt (GRN) — stock posts only when status = CONFIRMED.
model GoodsReceipt {
  id               String                    @id @default(cuid())
  publicId         String                    @unique
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder             @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  status           GoodsReceiptStatus        @default(DRAFT)
  /// Client/server idempotency key for Confirm Receipt (unique when set).
  confirmationKey  String?                   @unique
  warehouseCode    String                    @default("MAIN")
  supplierId       String
  supplier         Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  courier          String?
  awb              String?
  dispatchDate     DateTime?
  packageCount     Int?
  notes            String?
  billStoragePath  String?
  billFileName     String?
  billMimeType     String?
  excelStoragePath String?
  excelFileName    String?
  excelMimeType    String?
  purchaseBillId   String?                   @unique
  purchaseBill     PurchaseBill?             @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)
  closeReason      String?
  confirmedAt      DateTime?
  confirmedById    String?
  createdById      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  lines            GoodsReceiptLine[]
  billSummaries    GoodsReceiptBillSummary[]

  @@index([purchaseOrderId, status])
  @@index([status, createdAt])
}

model GoodsReceiptLine {
  id                  String                 @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt           @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine?     @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  lensType            LensType?
  lensId              String?
  productLabel        String?
  rangeLabel          String?
  powerLabel          String?
  orderedQuantity     Int                    @default(0)
  previouslyReceived  Int                    @default(0)
  outstandingBefore   Int                    @default(0)
  deliveredQuantity   Int                    @default(0)
  acceptedQuantity    Int                    @default(0)
  damagedQuantity     Int                    @default(0)
  shortQuantity       Int                    @default(0)
  excessQuantity      Int                    @default(0)
  lineStatus          GoodsReceiptLineStatus @default(PENDING)
  /// KEEP_PENDING | MARK_DAMAGED | ACCEPT_SHORT | REJECT_EXTRA
  actionCode          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@index([lensType, lensId])
}

/// Human-entered supplier bill range totals for range-wise reconciliation (no OCR).
model GoodsReceiptBillSummary {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productLabel   String
  rangeLabel     String?
  billQuantity   Int
  excelQuantity  Int          @default(0)
  difference     Int          @default(0)
  /// BILL_CORRECTION | EXCEL_CORRECTION | ACCEPT_EXCEL | KEEP_PENDING
  resolution     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([goodsReceiptId])
}

/// Atomic open-power lock: one approved/open PO may cover a power at a time.
model OpenPurchaseOrderPower {
  lensType            LensType
  lensId              String
  purchaseOrderId     String
  purchaseOrder       PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String            @unique
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@id([lensType, lensId])
  @@index([purchaseOrderId])
}

/// Phase F — cancelled-order money owed back to the customer.
enum OrderRefundStatus {
  DUE
  PARTIAL
  PAID
  CANCELLED
}

model OrderRefund {
  id         String              @id @default(cuid())
  orderId    String              @unique
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User                @relation(fields: [customerId], references: [id])
  amountDue  Decimal
  amountPaid Decimal             @default(0)
  status     OrderRefundStatus   @default(DUE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  payouts    OrderRefundPayout[]

  @@index([customerId, status])
  @@index([status, createdAt])
}

model OrderRefundPayout {
  id           String      @id @default(cuid())
  refundId     String
  refund       OrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  amount       Decimal
  mode         PaymentMode
  paidAt       DateTime
  reference    String?
  notes        String?
  recordedById String?
  recordedBy   User?       @relation("OrderRefundPayoutRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([refundId, paidAt])
}

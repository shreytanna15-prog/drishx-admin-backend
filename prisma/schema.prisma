// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum AccountApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Commercial / enforcement action separate from approval (Phase B).
enum AccountAction {
  NONE
  BLOCKED
  CREDIT_SUSPENDED
  CLOSED
}

enum GstinVerifyStatus {
  UNKNOWN
  ACTIVE
  INACTIVE
  INVALID
  ERROR
}

/// OTP channel for customer identity (Phase A — customer account configuration).
enum OtpChannel {
  MOBILE
  EMAIL
}

/// Why an OTP was sent. Used for rate limits, audit, and verify side effects.
enum OtpPurpose {
  SIGNUP
  LOGIN
  VERIFY_EMAIL
  WALK_IN
  ADMIN_INVITE
}

enum CustomerTaxType {
  REGISTERED
  UNREGISTERED
  COMPOSITION
  OTHER
}

model User {
  id                         String                @id @default(cuid())
  email                      String                @unique
  password                   String
  name                       String?
  role                       UserRole              @default(CUSTOMER)
  isActive                   Boolean               @default(true)
  isApproved                 Boolean               @default(true)
  approvalStatus             AccountApprovalStatus @default(APPROVED)
  gstNumber                  String?               @unique
  businessName               String?
  businessAddress            String?
  state                      String?
  pincode                    String?
  mobileNumber               String?
  /// Set only after successful mobile OTP (2factor / OTP_DEV_MODE).
  mobileVerifiedAt           DateTime?
  alternateMobileNumber      String?
  whatsappNumber             String?
  /// Set only after successful email OTP. Null if email skipped or not yet verified.
  emailVerifiedAt            DateTime?
  /// Set on Admin onboarding approve; cleared when client/Admin changes address fields.
  addressVerifiedAt          DateTime?
  shopName                   String?
  businessType               String?
  addressLine1               String?
  addressLine2               String?
  city                       String?
  businessEmail              String?
  shopPhoneNumber            String?
  legalBusinessName          String?
  tradeName                  String?
  gstRegistrationState       String?
  panNumber                  String?
  billingLegalName           String?
  billingAddress             String?
  billingCity                String?
  billingState               String?
  billingPincode             String?
  billingGstState            String?
  shippingLegalName          String?
  shippingAddress            String?
  shippingCity               String?
  shippingState              String?
  shippingPincode            String?
  /// GST customer classification for invoicing.
  customerType               CustomerTaxType       @default(UNREGISTERED)
  /// Max receivable balance before checkout hard-block (Phase D).
  creditLimit                Decimal?
  creditAllowed              Boolean               @default(true)
  accountAction              AccountAction         @default(NONE)
  /// Pricing tier A–F (default D = base / 0% until assigned).
  pricingTierId              String?
  pricingTier                PricingTier?          @relation(fields: [pricingTierId], references: [id])
  /// Staff who created this customer (Path B admin / Path C walk-in).
  createdByStaffId           String?
  gstinVerifyStatus          GstinVerifyStatus     @default(UNKNOWN)
  gstinVerifiedAt            DateTime?
  gstinVerifyRaw             Json?
  gstinVerifiedById          String?
  approvedAt                 DateTime?
  approvedById               String?
  rejectionReason            String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  staffRoleId                String?
  staffRole                  StaffRole?            @relation(fields: [staffRoleId], references: [id])
  transactions               Transaction[]
  orders                     Order[]               @relation("CustomerOrders")
  assignedOrders             Order[]               @relation("AssignedOrdersToEmployee")
  /// Orders this staff member placed on behalf of a customer (RW-10).
  placedOrders               Order[]               @relation("OrdersPlacedByStaff")
  notifications              Notification[]
  invoices                   Invoice[]
  assignedTasks              Task[]                @relation("AssignedTasksToEmployee")
  createdTasks               Task[]                @relation("AssignedTasksByAdmin")
  cartReservations           CartReservation[]
  returnRequests             ReturnRequest[]       @relation("CustomerReturnRequests")
  assignedReturnRequests     ReturnRequest[]       @relation("AssignedReturnRequestsToEmployee")
  reviewedReturnRequests     ReturnRequest[]       @relation("ReviewedReturnRequestsByAdmin")
  returnImages               ReturnRequestImage[]
  returnTimelineEvents       ReturnTimelineEvent[]
  creditNotes                CreditNote[]
  orderActivityLogs          OrderActivityLog[]    @relation("OrderActivityActors")
  createdPowerVersions       OrderPowerVersion[]   @relation("PowerVersionCreatedBy")
  acceptedPowerVersions      OrderPowerVersion[]   @relation("PowerVersionAcceptedBy")
  refreshTokens              RefreshToken[]
  payments                   Payment[]             @relation("CustomerPayments")
  paymentClaims              PaymentClaim[]        @relation("CustomerPaymentClaims")
  reviewedPaymentClaims      PaymentClaim[]        @relation("PaymentClaimReviewer")
  customerLedgerEntries      CustomerLedgerEntry[]
  cashAccounts               CashAccount[]         @relation("EmployeeCashAccounts")
  expenseRequests            ExpenseRequest[]      @relation("ExpenseRequestEmployee")
  reviewedExpenseRequests    ExpenseRequest[]      @relation("ExpenseRequestReviewer")
  supplierPayments           SupplierPayment[]     @relation("SupplierPaymentRecorder")
  loyaltyWallet              LoyaltyWallet?
  loyaltyTransactions        LoyaltyTransaction[]
  loyaltyCreatedTransactions LoyaltyTransaction[]  @relation("LoyaltyCreatedBy")
  attendanceRecords          AttendanceRecord[]    @relation("AttendanceEmployee")
  attendanceMarkedBy         AttendanceRecord[]    @relation("AttendanceMarkedBy")
  orderRefunds               OrderRefund[]
  orderRefundPayouts         OrderRefundPayout[]   @relation("OrderRefundPayoutRecorder")
}

/// Customer pricing tiers A–F. Tier D is the base (isBase=true).
model PricingTier {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String?
  discountPercent Decimal  @default(0)
  isBase          Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  users           User[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Local OTP challenge row for rate limits + audit. Never store the raw OTP code.
model OtpChallenge {
  id                String     @id @default(cuid())
  channel           OtpChannel
  destination       String
  provider          String
  providerSessionId String?
  purpose           OtpPurpose
  expiresAt         DateTime
  attempts          Int        @default(0)
  consumedAt        DateTime?
  createdByStaffId  String?
  /// DEV-mode only: sha256 of the issued code. Null when provider holds the OTP.
  codeHash          String?
  createdAt         DateTime   @default(now())

  @@index([destination, channel, createdAt])
  @@index([destination, purpose, consumedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model StaffRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions Json
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isSystem])
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum ExpenseCategory {
  PROCUREMENT
  MANUAL
}

model Transaction {
  id            String            @id @default(cuid())
  reference     String            @unique
  amount        Decimal
  currency      String            @default("INR")
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  description   String?
  category      ExpenseCategory?
  voidedAt      DateTime?
  voidReason    String?
  user          User              @relation(fields: [userId], references: [id])
  userId        String
  ledgerEntries LedgerEntry[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  transactionId String
  entryType     LedgerEntryType
  amount        Decimal
  description   String?
  createdAt     DateTime        @default(now())
}

enum Eye {
  LEFT
  RIGHT
}

model SingleVisionLens {
  id String @id @default(cuid())

  // Product line / series — used to group lens families
  // e.g., "WHITE BLUE CUT", "WHITE SV BLUE CUT SPECIAL COLORS", "WHITE NO BLUE CUT", "WHITE REGULAR",
  //        "THIN PLUS LENTICULAR", "WHITE 55MM", "PHOTOGREY WITHOUT BLUE", "PHOTOGREY BLUE CUT SV",
  //        "BLUE CUT SV", "PHOTO BLUE CUT", "PG SV", "SUPER POLY BLUE CUT", "SUPER PG POLY BLUE CUT", "HC SV"
  category String?

  // Brand / product name within the category
  // WHITE SV BLUE CUT SPECIAL COLORS → "EYECONIC - BLUE CUT"
  // PHOTOGREY WITHOUT BLUE           → "SUN-SYNC", "DIAMOND", "RAPID"
  // PHOTOGREY BLUE CUT SV            → "SOLAR-X"
  // WHITE BLUE CUT                   → "ASH", "DR-BLU", "OCEAN"
  // WHITE NO BLUE CUT                → "DIAMOND BLUE/MAJENTA", "DIAMOND CRY.GREEN/CRY.BLUE", "POLY-SV BULLET"
  // WHITE REGULAR                    → "DIAMOND/RUBY", "BROTECTOR"
  // THIN PLUS                        → "LENTICULAR", "TRUTUFF HC", "55MM"
  // Other series                     → "ENZO 1.60 Green", "DREAMZ 1.60 Green", "I-TRON 1.56 Invisible Blue",
  //                                    "SOFY 1.60 Blue", "SIGNUS 1.60 Dual Blue+Green", "SOHO 1.60 Magenta",
  //                                    "SUPER 1.61 Green", "B-TRON 1.67 Green", "T-TRON Tintable 1.56",
  //                                    "KRASOL PG HC", "STARK PG HC", "OISHI Blue", "STARK Green",
  //                                    "DKL BLUE", "DKL GREEN", "PG-TRON CLIK Invisible Blue",
  //                                    "STARK Green Photo Brown", "MARI BLU", "BLU-GUARD", "DUAL TWIN", "MARI-STEEL"
  brand String

  // Item / sub-type (optional)
  // e.g., "POLY SV - STEEL", "BLUE CUT", "Tintable", "SPECIAL COATING - DIAMOND"
  item String?

  index Decimal // e.g., 1.56, 1.59, 1.599, 1.60, 1.61, 1.67, 1.74

  // Coating type (surface treatment / colour)
  // e.g., "HC", "HMC", "GREEN", "BLUE", "BR HC", "Invisible Blue", "Magenta",
  //        "VIOLET", "DUAL", "CRY.GREEN/CRY.BLUE", "Dual Blue+Green", "Photo Brown",
  //        "INVISIBLE BLUE EXTRA WHITE", "MAGENTA NIGHT DRIVE", "BLU/GREEN"
  coating String

  sph           Decimal?
  sphStartRange Decimal?
  cyl           Decimal?
  cylStartRange Decimal?
  /// Cross-cylinder catalog power (e.g. -2 for "cross -2"). Mutually exclusive with sph/cyl.
  crossPower    Decimal?
  costPrice     Decimal?
  price         Decimal
  quantity      Int      @default(0)
  isDisabled    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model KryptokLens {
  id String @id @default(cuid())

  // Kryptok lens series / product line (price-sheet ITEM column)
  // e.g., "WHITE KT", "BLUE CUT KT HMC", "PG KT", "PG BLUE CUT KT", "POLY KT"
  category String?

  // Brand within the category
  // WHITE KT / BLUE CUT KT HMC → "PROTECTOR"
  // BLUE CUT KT                → "VENUS", "INTENSITY", "INVISIO"
  // PG BLUE CUT KT             → "HI-MAX/RAPID"
  // POLY KT                    → (HC / HMC GREEN variants)
  brand String?

  // Coating / colour variant
  // e.g., "HC", "HMC", "HMC GREEN", "GREEN", "VIOLET", "LIGHT BLU", "BLUE"
  coating String?

  /// Wholesale / shop item label — e.g. "CROSS" for cross compound lines.
  item String?

  sph           Decimal
  sphStartRange Decimal?
  cyl           Decimal?
  cylStartRange Decimal?

  /// Cross-cylinder catalog power (CYL value, e.g. -2.00 for cross -2).
  crossPower Decimal?

  // Axis of cylinder:
  //   90  = ST.AXIS (Straight Axis)
  //  180  = REV AXIS (Reverse Axis)
  //  45/135 = SPL AXIS (Special / Oblique Axis)
  axis Int?

  // Bifocal addition power — typically PLANO or +4.00
  add Decimal

  costPrice  Decimal?
  price      Decimal
  quantity   Int      @default(0)
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model ProgressiveLens {
  id            String   @id @default(cuid())
  category      String? // e.g., "WITHOUT BLUE CUT", "BLUE CUT"
  item          String // e.g., "WHITE PROGRESSIVE", "PG BR HMC PROG", "PHOTO BROWN BR PROG", "POLY PG BR PROGRESSIVE"
  brand         String // e.g., "PROX", "SPRO", "STARK", "SUPER Green", "Pro-Tron 9+4 Design"
  index         Decimal // e.g., 1.56, 1.59, 1.61
  type          String // e.g., "HC", "HMC", "SHMC"
  coating       String // e.g., "Green", "Blue DL", "Clik (Inv Blue)", "LR Green"
  sph           Decimal
  sphStartRange Decimal?
  cyl           Decimal?
  cylStartRange Decimal?
  axis          Int?
  add           Decimal
  eye           Eye
  costPrice     Decimal?
  price         Decimal
  quantity      Int      @default(0)
  isDisabled    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model OriVisionLens {
  id            String   @id @default(cuid())
  category      String? // e.g., "SUPER-HYDROPHOPIC"
  item          String? // e.g., "OPTIMAX SV PG BLUE CUT", "CHROMA", "WIZARD"
  brand         String // e.g., "MARI-BLU", "GREEN", "1.56 SUPER OPTIMAX"
  index         Decimal // e.g., 1.56, 1.61, 1.67, 1.59
  coating       String // e.g., "INVISIBLE BLUE", "GREEN", "MAGENTA NIGHT DRIVE", "INVISIBLE MARI-BLU"
  sph           Decimal
  sphStartRange Decimal?
  cyl           Decimal?
  cylStartRange Decimal?
  price         Decimal
  quantity      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model MagnusLens {
  id       String   @id @default(cuid())
  category String? // e.g., "BLUE CUT SV 1.56 Premium Range", "SV Hi-Index", "DIGITAL PROGRESSIVE LENSES"
  item     String? // e.g., "EVO 1.56 Green", "MAGNUS 1.67 AIR", "NUPRO HC"
  index    Decimal? // e.g., 1.56, 1.67, 1.74
  coating  String? // e.g., "Blue Cut Green", "UC", "Green"

  sph           Decimal
  sphStartRange Decimal?
  cyl           Decimal?
  cylStartRange Decimal?
  axis          Int? // Optional: For astigmatism or progressive lenses
  add           Decimal? // Optional: For progressive lenses

  price     Decimal
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model BifocalLens {
  id      String  @id @default(cuid())
  brand   String // e.g., "KORAL HC", "TESLA GREEN", "STARK", "Poly"
  item    String // e.g., "HC KT", "BR HMC KT", "BRC KT", "PG HC KT", "PG BR HMC KT", "Poly BR KT BLUE"
  coating String? // e.g., "KT", "HMC KT", "BR HMC KT"

  // Prescription fields
  sph           Decimal
  sphStartRange Decimal?
  cyl           Decimal? // Cylinder value (e.g., Cyl 2, Cyl 3)
  cylStartRange Decimal?
  axis          Int? // Axis value (e.g., 90, 180, 45, 135)
  add           Decimal? // Addition power for bifocal segment

  price     Decimal
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

// ─── Customer & Order ─────────────────────────────────────────

enum LensType {
  SINGLE_VISION
  KRYPTOK
  PROGRESSIVE
  ORI_VISION
  MAGNUS
  BIFOCAL
}

enum OrderStatus {
  PENDING
  PICKING
  PACKED
  DISPATCHED
  PARTIALLY_FULFILLED
  AWAITING_PROCUREMENT
  COMPLETED
  CANCELLED
}

/// Origin of order placement. Null on legacy rows (do not guess).
enum OrderSource {
  CUSTOMER_APP
  EMPLOYEE_ON_BEHALF
  ADMIN_PANEL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum NotificationType {
  ORDER_STATUS_UPDATED
  ORDER_PLACED
  TASK_ASSIGNED
  RETURN_REQUEST_SUBMITTED
  RETURN_REQUEST_UPDATED
  RETURN_REQUEST_DECIDED
  ALTERNATE_POWER_SUGGESTED
  ALTERNATE_POWER_ACCEPTED
  ALTERNATE_POWER_REJECTED
}

enum PowerVersionSource {
  ORIGINAL
  ALTERNATE
}

enum PowerVersionStatus {
  ACTIVE
  SUPERSEDED
  POWER_NOT_AVAILABLE
  FINAL_FULFILLED
}

enum AlternateAvailability {
  WAREHOUSE
  SUPPLIER
  OUT_OF_STOCK
}

enum AlternateSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ReturnRequestType {
  RETURN
  REPLACEMENT
}

enum ReturnRequestStatus {
  SUBMITTED
  MORE_INFO_REQUIRED
  ESCALATED_TO_ADMIN
  AWAITING_MATERIAL
  APPROVED_CREDIT
  APPROVED_REPLACEMENT
  REJECTED
  CLOSED
}

enum ReturnReason {
  WRONG_POWER
  MANUFACTURING_DEFECT
  COATING_ISSUE
  BROKEN_IN_TRANSPORT
  WRONG_PRODUCT
  EXCESS_STOCK_RETURN
  OTHER
}

enum StockDisposition {
  RETURN_TO_SALEABLE
  DAMAGED_STOCK
  SEND_TO_IMPORTER
  SCRAP
}

enum ReturnDecisionType {
  CREDIT
  REPLACEMENT
  REJECT
}

enum ReturnTimelineEventType {
  SUBMITTED
  PHOTO_ADDED
  MORE_INFO_REQUIRED
  ESCALATED
  APPROVED_CREDIT
  APPROVED_REPLACEMENT
  REJECTED
  CLOSED
}

enum TaskStatus {
  PENDING
  COMPLETED
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  order     Order?           @relation(fields: [orderId], references: [id])
  orderId   String?
  task      Task?            @relation(fields: [taskId], references: [id])
  taskId    String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum CartLineType {
  RETAIL
  WHOLESALE
}

/// Customer cart lines — no stock hold; inventory is reserved on order placement.
model CartReservation {
  id               String       @id @default(cuid())
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  lensType         LensType
  lensId           String
  cartLineKey      String
  lineType         CartLineType @default(RETAIL)
  wholesaleSpec    Json?
  quantity         Float
  reservedQuantity Float        @default(0)
  unitPrice        Decimal
  sph              Decimal?
  cyl              Decimal?
  add              Decimal?
  axis             Int?
  eye              String?
  brand            String?
  coating          String?
  item             String?
  lensTypeLabel    String?
  expiresAt        DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([userId, cartLineKey])
  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id                    String                     @id @default(cuid())
  orderNumber           Int?                       @unique
  checkoutBatchId       String?
  user                  User                       @relation("CustomerOrders", fields: [userId], references: [id])
  userId                String
  /// Staff employee responsible for fulfilling / procuring this order (or batch).
  assignedTo            User?                      @relation("AssignedOrdersToEmployee", fields: [assignedToId], references: [id])
  assignedToId          String?
  assignedAt            DateTime?
  /// RW-10: who actually placed the order (admin/employee). Null for customer self-checkout and legacy rows.
  placedBy              User?                      @relation("OrdersPlacedByStaff", fields: [placedByUserId], references: [id])
  placedByUserId        String?
  /// RW-10: placement channel. Null = legacy (unknown); never invent a backfill.
  orderSource           OrderSource?
  /// RW-05: true for RX / photo-prescription orders that stay admin-only until release.
  warehouseHold         Boolean                    @default(false)
  /// When set, assigned staff may see/work the order on warehouse queues.
  warehouseReleasedAt   DateTime?
  warehouseReleasedById String?
  lineType              CartLineType               @default(RETAIL)
  wholesaleSpec         Json?
  lensType              LensType
  // Exactly one of these will be set based on lensType
  singleVisionLens      SingleVisionLens?          @relation(fields: [singleVisionLensId], references: [id])
  singleVisionLensId    String?
  kryptokLens           KryptokLens?               @relation(fields: [kryptokLensId], references: [id])
  kryptokLensId         String?
  progressiveLens       ProgressiveLens?           @relation(fields: [progressiveLensId], references: [id])
  progressiveLensId     String?
  oriVisionLens         OriVisionLens?             @relation(fields: [oriVisionLensId], references: [id])
  oriVisionLensId       String?
  magnusLens            MagnusLens?                @relation(fields: [magnusLensId], references: [id])
  magnusLensId          String?
  bifocalLens           BifocalLens?               @relation(fields: [bifocalLensId], references: [id])
  bifocalLensId         String?
  quantity              Float
  /// Stock allocated at order time (logical hold; physical qty reduced on pick/pack).
  reservedQuantity      Float                      @default(0)
  /// Units picked from inventory by staff (decrements lens stock when increased).
  pickedQuantity        Float                      @default(0)
  unitPrice             Decimal
  totalAmount           Decimal
  /// Snapshot of customer pricing tier at placement (invoice reprint fidelity).
  tierCode              String?
  tierDiscountPercent   Decimal?
  tierDiscountAmount    Decimal?
  /// Customer-selected prescription at checkout (cart), not catalog lens defaults.
  sph                   Decimal?
  cyl                   Decimal?
  axis                  Int?
  add                   Decimal?
  eye                   String?
  status                OrderStatus                @default(PENDING)
  notes                 String? // Customer special instructions for this order
  /// Staff-only ops notes — never exposed to CUSTOMER API responses.
  internalNotes         String?
  cancelReason          String?
  courierName           String?
  trackingNumber        String?
  /// Courier dispatch slot decided at placement: null when the dispatch cutoff was disabled at creation.
  dispatchDate          DateTime?
  /// True when the placement time fell after the admin-configured dispatch cutoff.
  cutoffDeferred        Boolean                    @default(false)
  /// Super-admin manual override permitting early dispatch of a deferred order.
  dispatchOverrideStamp Json?
  /// Delivery service chosen at order time (charge calculated after packing).
  deliveryService       DeliveryService?           @relation(fields: [deliveryServiceId], references: [id])
  deliveryServiceId     String?
  delivery              OrderDelivery?
  orderImageUrl         String? // Supabase URL when customer submits a prescription photo
  transactionId         String? // ID of the CREDIT Transaction auto-created on sale
  archivedAt            DateTime?
  archiveReason         String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  notifications         Notification[]
  invoice               Invoice?
  wholesaleLineItems    WholesaleOrderLineItem[]
  returnRequests        ReturnRequest[]            @relation("OrderReturnRequests")
  returnItems           ReturnRequestItem[]        @relation("OrderReturnItems")
  inventoryMovements    InventoryMovement[]
  activityLogs          OrderActivityLog[]
  powerVersions         OrderPowerVersion[]
  alternateSuggestions  AlternatePowerSuggestion[]
  procurementRequests   ProcurementRequest[]
  orderRefund           OrderRefund?

  @@index([checkoutBatchId])
  @@index([assignedToId])
  @@index([assignedToId, status])
  @@index([placedByUserId])
  @@index([orderSource])
  @@index([status])
  @@index([dispatchDate])
  @@index([warehouseHold, warehouseReleasedAt])
}

/// Immutable power history for retail orders. Version 1 is always the original ordered power.
model OrderPowerVersion {
  id               String                     @id @default(cuid())
  order            Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  versionNumber    Int
  sph              Decimal?
  cyl              Decimal?
  axis             Int?
  add              Decimal?
  eye              String?
  lensType         LensType
  lensId           String?
  source           PowerVersionSource         @default(ORIGINAL)
  status           PowerVersionStatus         @default(ACTIVE)
  reservedQuantity Float                      @default(0)
  pickedQuantity   Float                      @default(0)
  isFinalFulfilled Boolean                    @default(false)
  createdBy        User?                      @relation("PowerVersionCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  acceptedBy       User?                      @relation("PowerVersionAcceptedBy", fields: [acceptedById], references: [id])
  acceptedById     String?
  acceptedAt       DateTime?
  supersededAt     DateTime?
  notes            String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  suggestionsFor   AlternatePowerSuggestion[]

  @@unique([orderId, versionNumber])
  @@index([orderId, status])
  @@index([orderId, isFinalFulfilled])
}

model AlternatePowerSuggestion {
  id            String                    @id @default(cuid())
  order         Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  forVersion    OrderPowerVersion         @relation(fields: [forVersionId], references: [id], onDelete: Cascade)
  forVersionId  String
  sph           Decimal
  cyl           Decimal?
  axis          Int?
  add           Decimal?
  eye           String?
  lensType      LensType
  lensId        String
  availability  AlternateAvailability
  etaDays       Int?
  distanceScore Float
  status        AlternateSuggestionStatus @default(PENDING)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([orderId, status])
  @@index([forVersionId])
}

/// Key/value app configuration (e.g. alternate-power nearest rules).
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model OrderActivityLog {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  actor       User?    @relation("OrderActivityActors", fields: [actorUserId], references: [id])
  actorUserId String?
  action      String
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}

model WholesaleOrderLineItem {
  id               String   @id @default(cuid())
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  powerKey         String
  quantity         Float
  reservedQuantity Float    @default(0)
  unitPrice        Decimal
  totalAmount      Decimal
  sph              Decimal
  cyl              Decimal?
  axis             Int?
  add              Decimal?
  needsProcurement Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([orderId, powerKey])
  @@index([orderId])
}

model Invoice {
  id                    String                 @id @default(cuid())
  invoiceNumber         String                 @unique
  user                  User                   @relation(fields: [userId], references: [id])
  userId                String
  order                 Order                  @relation(fields: [orderId], references: [id])
  orderId               String                 @unique
  /// Grand total (taxable + GST + rounding). Kept for backward-compatible clients.
  amount                Decimal
  status                InvoiceStatus          @default(ISSUED)
  issuedAt              DateTime?
  dueDate               DateTime?
  paymentTerms          String?
  financialYear         String?
  placeOfSupplyState    String?
  placeOfSupplyCode     String?
  isInterState          Boolean                @default(false)
  /// True when HSN/GST fell back to company defaults or tax master incomplete.
  taxIncomplete         Boolean                @default(false)
  grossAmount           Decimal                @default(0)
  discountAmount        Decimal                @default(0)
  taxableAmount         Decimal                @default(0)
  cgstAmount            Decimal                @default(0)
  sgstAmount            Decimal                @default(0)
  igstAmount            Decimal                @default(0)
  roundingAdjustment    Decimal                @default(0)
  amountPaid            Decimal                @default(0)
  amountOutstanding     Decimal                @default(0)
  /// Snapshots at issue time
  companyGstin          String?
  companyLegalName      String?
  companyState          String?
  companyStateCode      String?
  customerGstin         String?
  customerLegalName     String?
  customerBillingState  String?
  customerTypeSnapshot  CustomerTaxType?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  lines                 InvoiceLine[]
  returnRequests        ReturnRequest[]
  creditNotes           CreditNote[]
  creditNoteAllocations CreditNoteAllocation[]
  paymentAllocations    PaymentAllocation[]
  paymentClaimItems     PaymentClaimItem[]
  customerLedgerEntries CustomerLedgerEntry[]

  @@index([userId, status])
  @@index([status, issuedAt])
  @@index([financialYear])
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  lineNumber     Int
  description    String
  sku            String?
  lensType       String?
  lensId         String?
  powerLabel     String?
  hsnCode        String?
  quantity       Decimal
  unitPrice      Decimal
  discountAmount Decimal  @default(0)
  taxableAmount  Decimal
  gstRatePercent Decimal
  cgstAmount     Decimal  @default(0)
  sgstAmount     Decimal  @default(0)
  igstAmount     Decimal  @default(0)
  lineTotal      Decimal
  createdAt      DateTime @default(now())

  @@index([invoiceId])
  @@index([hsnCode])
}

/// Delivery service master: one courier can have many services (Land / Air).
/// Customer rate is shown to shops; internal cost stays hidden (delivery margin).
model DeliveryService {
  id               String          @id @default(cuid())
  courierCompany   String
  serviceName      String // e.g. "Sri Raj Courier — Land"
  serviceType      String          @default("LAND") // LAND / AIR / SURFACE / PICKUP
  isActive         Boolean         @default(true)
  customerRate     Decimal         @default(0) // per kg (0 = free pickup)
  billingMethod    String          @default("PER_KG") // PER_KG / FLAT
  flatCharge       Decimal         @default(0) // used when billingMethod = FLAT
  minCharge        Decimal         @default(0)
  minWeight        Decimal         @default(1) // minimum chargeable kg
  weightRounding   String          @default("NEXT_1KG") // ACTUAL / NEXT_1KG / NEXT_0_5KG
  internalCostRate Decimal         @default(0) // per kg cost paid to courier
  internalMinCost  Decimal         @default(0)
  etaText          String? // "1–2 days"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  orders           Order[]
  deliveries       OrderDelivery[]

  @@index([isActive])
}

/// Per-order delivery audit record. Written at PACKED time, never silently edited.
model OrderDelivery {
  id                String          @id @default(cuid())
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String          @unique
  deliveryService   DeliveryService @relation(fields: [deliveryServiceId], references: [id])
  deliveryServiceId String
  actualWeight      Decimal
  chargeableWeight  Decimal
  customerCharge    Decimal
  internalCost      Decimal
  margin            Decimal
  packages          Json? // [{ no: 1, weight: 1.8 }]
  weightEnteredBy   String?
  weightEnteredAt   DateTime?
  weightHistory     Json? // [{ from, to, by, at, reason }]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([deliveryServiceId])
}

model Task {
  id            String         @id @default(cuid())
  title         String
  details       String?
  dueDate       DateTime
  status        TaskStatus     @default(PENDING)
  completedAt   DateTime?
  assignedTo    User           @relation("AssignedTasksToEmployee", fields: [assignedToId], references: [id])
  assignedToId  String
  assignedBy    User           @relation("AssignedTasksByAdmin", fields: [assignedById], references: [id])
  assignedById  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
}

model ReturnRequest {
  id                 String                @id @default(cuid())
  requestNumber      String                @unique
  customer           User                  @relation("CustomerReturnRequests", fields: [customerId], references: [id])
  customerId         String
  primaryOrder       Order?                @relation("OrderReturnRequests", fields: [primaryOrderId], references: [id])
  primaryOrderId     String?
  primaryInvoice     Invoice?              @relation(fields: [primaryInvoiceId], references: [id])
  primaryInvoiceId   String?
  assignedEmployee   User?                 @relation("AssignedReturnRequestsToEmployee", fields: [assignedEmployeeId], references: [id])
  assignedEmployeeId String?
  reviewedByAdmin    User?                 @relation("ReviewedReturnRequestsByAdmin", fields: [reviewedByAdminId], references: [id])
  reviewedByAdminId  String?
  requestType        ReturnRequestType
  status             ReturnRequestStatus   @default(SUBMITTED)
  customerRemarks    String?
  employeeRemarks    String?
  adminRemarks       String?
  rejectionReason    String?
  decisionType       ReturnDecisionType?
  stockDisposition   StockDisposition?
  approvedAmount     Decimal?
  replacementBatchId String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  items              ReturnRequestItem[]
  images             ReturnRequestImage[]
  timelineEvents     ReturnTimelineEvent[]
  creditNote         CreditNote?
  inventoryMovements InventoryMovement[]

  @@index([customerId, createdAt])
  @@index([assignedEmployeeId, status])
  @@index([status, createdAt])
}

model ReturnRequestItem {
  id              String        @id @default(cuid())
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnRequestId String
  originalOrder   Order         @relation("OrderReturnItems", fields: [originalOrderId], references: [id])
  originalOrderId String
  lensType        LensType
  lensId          String?
  lensLabel       String
  quantity        Float
  eye             String?
  reason          ReturnReason
  itemRemarks     String?
  /// Snapshot of ordered power at request time.
  originalSph     Decimal?
  originalCyl     Decimal?
  originalAxis    Int?
  originalAdd     Decimal?
  /// Customer-requested replacement power (catalog range validated on submit).
  requestedSph    Decimal?
  requestedCyl    Decimal?
  requestedAxis   Int?
  requestedAdd    Decimal?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([returnRequestId])
  @@index([originalOrderId])
}

model ReturnRequestImage {
  id               String        @id @default(cuid())
  returnRequest    ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnRequestId  String
  uploadedBy       User?         @relation(fields: [uploadedByUserId], references: [id])
  uploadedByUserId String?
  imageUrl         String
  createdAt        DateTime      @default(now())

  @@index([returnRequestId])
}

model ReturnTimelineEvent {
  id              String                  @id @default(cuid())
  returnRequest   ReturnRequest           @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnRequestId String
  actorUser       User?                   @relation(fields: [actorUserId], references: [id])
  actorUserId     String?
  eventType       ReturnTimelineEventType
  message         String
  createdAt       DateTime                @default(now())

  @@index([returnRequestId, createdAt])
}

model CreditNote {
  id                    String                 @id @default(cuid())
  creditNoteNumber      String                 @unique
  returnRequest         ReturnRequest          @relation(fields: [returnRequestId], references: [id])
  returnRequestId       String                 @unique
  user                  User                   @relation(fields: [userId], references: [id])
  userId                String
  /// Primary / display invoice (legacy + first allocation). Prefer allocations[] for audit.
  invoice               Invoice?               @relation(fields: [invoiceId], references: [id])
  invoiceId             String?
  amount                Decimal
  taxableAmount         Decimal                @default(0)
  cgstAmount            Decimal                @default(0)
  sgstAmount            Decimal                @default(0)
  igstAmount            Decimal                @default(0)
  reason                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  customerLedgerEntries CustomerLedgerEntry[]
  /// Per-invoice applications (Phase 4A). Empty for historical CNs issued before this table.
  allocations           CreditNoteAllocation[]
}

/// Durable per-invoice attribution for a credit note (multi-order returns).
model CreditNoteAllocation {
  id            String     @id @default(cuid())
  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  creditNoteId  String
  invoice       Invoice    @relation(fields: [invoiceId], references: [id])
  invoiceId     String
  /// Tax-inclusive amount applied to this invoice's outstanding.
  amount        Decimal
  taxableAmount Decimal    @default(0)
  cgstAmount    Decimal    @default(0)
  sgstAmount    Decimal    @default(0)
  igstAmount    Decimal    @default(0)
  createdAt     DateTime   @default(now())

  @@unique([creditNoteId, invoiceId])
  @@index([creditNoteId])
  @@index([invoiceId])
}

model InventoryMovement {
  id              String           @id @default(cuid())
  returnRequest   ReturnRequest    @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnRequestId String
  order           Order?           @relation(fields: [orderId], references: [id])
  orderId         String?
  lensType        LensType
  lensId          String?
  quantity        Float
  disposition     StockDisposition
  notes           String?
  createdAt       DateTime         @default(now())

  @@index([returnRequestId, createdAt])
}

/// RW-09: admin product-master status (soft visibility — never hard-deletes lens leaves).
enum CatalogProductStatus {
  ACTIVE
  HELD
  ARCHIVED
}

/// RW-09: lens family for CatalogProduct (subset of LensType sold in shop).
enum CatalogLensFamily {
  SINGLE_VISION
  KRYPTOK
  PROGRESSIVE
}

/// RW-09 product master facade. Stock/order FKs still point at lens leaf tables.
/// identityKey encodes type+brand/line+index+coating (see app/lib/catalog/product-identity.ts).
model CatalogProduct {
  id               String               @id @default(cuid())
  lensFamily       CatalogLensFamily
  category         String?
  brand            String
  item             String?
  /// Refractive index (required for SV / Progressive).
  index            Decimal?
  coating          String
  /// Progressive design/type label (maps to ProgressiveLens.type).
  progressiveType  String?
  defaultPrice     Decimal
  defaultCostPrice Decimal?
  status           CatalogProductStatus @default(ACTIVE)
  identityKey      String               @unique
  notes            String?
  heldAt           DateTime?
  heldByUserId     String?
  archivedAt       DateTime?
  archivedByUserId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  ranges           CatalogRange[]

  @@index([lensFamily, status])
  @@index([brand])
  @@index([coating])
  @@index([status])
}

/// How leaves under a CatalogRange are stored.
/// LEGACY_BAND: one shared-quantity band row (historical price-sheet SKU).
/// POWER_WISE: one exact-power leaf per sellable SPH×CYL (and family extras).
enum CatalogLeafStorage {
  LEGACY_BAND
  POWER_WISE
}

/// RW-09 range attached to a product.
/// Bounds describe coverage; leaves[] are the stock SKUs (1 band or N exact powers).
model CatalogRange {
  id          String             @id @default(cuid())
  product     CatalogProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  label       String
  sphStart    Decimal
  sphEnd      Decimal
  cylStart    Decimal?
  cylEnd      Decimal?
  /// Kryptok / Progressive extras stored on each leaf as well.
  add         Decimal?
  axis        Int?
  eye         Eye?
  price       Decimal
  costPrice   Decimal?
  /// Count of linked leaves (exact powers or 1 for a legacy band).
  powerCount  Int                @default(0)
  leafStorage CatalogLeafStorage @default(POWER_WISE)
  /// Lens family for linked leaves (polymorphic with CatalogRangeLeaf.lensId).
  lensType    LensType
  /// Representative leaf id (legacy band id, or first exact-power leaf). Optional when leaves[] is source of truth.
  lensId      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  leaves      CatalogRangeLeaf[]

  @@unique([productId, label])
  @@index([productId])
  @@index([lensType, lensId])
}

/// Maps a catalog range to one or more lens table rows (no cross-table FK).
/// Unique (lensType, lensId) ensures a leaf belongs to at most one managed range.
model CatalogRangeLeaf {
  id                    String       @id @default(cuid())
  range                 CatalogRange @relation(fields: [rangeId], references: [id], onDelete: Cascade)
  rangeId               String
  lensType              LensType
  lensId                String
  /// Set when product Hold/Archive disabled this leaf; cleared on unhold if we own the disable.
  disabledByProductHold Boolean      @default(false)
  createdAt             DateTime     @default(now())

  @@unique([lensType, lensId])
  @@unique([rangeId, lensId])
  @@index([rangeId])
}

/// Admin-managed shop/stock product lines under a lens type (e.g. BRC, HC KT).
/// System rows are seeded from wholesale catalog constants; custom rows are admin-created.
model CatalogProductLine {
  id             String   @id @default(cuid())
  /// single-vision | kryptok | progressive
  lensType       String
  /// Display / filter name, e.g. "BRC"
  name           String
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  /// Seeded system lines cannot be hard-deleted or renamed
  isSystem       Boolean  @default(false)
  /// Product-driven GST (overrides company default when set).
  hsnCode        String?
  gstRatePercent Decimal?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([lensType, name])
  @@index([lensType, isActive, sortOrder])
}

/// Admin-managed coating filter chips for shop/wholesale (e.g. GREEN, Blue Coat).
/// Canonical `name` matches the free-text `coating` field on lens SKU rows.
model CoatingFilterLabel {
  id          String   @id @default(cuid())
  /// single-vision | kryptok | progressive
  lensType    String
  /// Canonical coating value stored on SKUs and shown on chips
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  /// Seeded from existing distinct coatings; custom ones are admin-created
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([lensType, name])
  @@index([lensType, isActive, sortOrder])
}

// --- Product catalog attribute masters + LensProduct (RW-09 / docs/product-catalog) ---
// Display-only SKU master; does not replace CatalogProduct leaf generation or legacy lens tables.

model LensFamily {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  products  LensProduct[]

  @@index([isActive, sortOrder])
}

model LensBase {
  id            String                 @id @default(cuid())
  code          String                 @unique
  name          String
  isActive      Boolean                @default(true)
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  materialLinks LensBaseMaterialLink[]
  products      LensProduct[]

  @@index([isActive, sortOrder])
}

model LensMaterial {
  id        String                 @id @default(cuid())
  code      String                 @unique
  name      String
  isActive  Boolean                @default(true)
  sortOrder Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  baseLinks LensBaseMaterialLink[]
  products  LensProduct[]

  @@index([isActive, sortOrder])
}

model LensIndex {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  /// Numeric refractive index when parseable (e.g. 1.56).
  value     Decimal?
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  products  LensProduct[]

  @@index([isActive, sortOrder])
}

model LensCoating {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// RC-04: coating is not product identity; master kept for Attributes UI only.

  @@index([isActive, sortOrder])
}

model LensColor {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  products  LensProduct[]

  @@index([isActive, sortOrder])
}

/// RC-03: power-range attribute master (SPH/CYL bounds picked from stepped selects).
/// Display label is derived (`-6.00/+2.00`); not stored.
model LensPowerRange {
  id       String               @id @default(cuid())
  sphMin   Decimal              @db.Decimal(6, 2)
  sphMax   Decimal              @db.Decimal(6, 2)
  cylMin   Decimal              @db.Decimal(6, 2)
  cylMax   Decimal              @db.Decimal(6, 2)
  isActive Boolean              @default(true)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  variants  LensProductVariant[]

  @@unique([sphMin, sphMax, cylMin, cylMax])
  @@index([isActive, sortOrder])
}

/// Which materials are allowed under a given base (create-product cascade).
model LensBaseMaterialLink {
  id         String       @id @default(cuid())
  baseId     String
  materialId String
  base       LensBase     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  material   LensMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([baseId, materialId])
  @@index([materialId])
}

/// RC-04 parent: attribute combination only (no sellable SKU). Variants hold SKU/name/price.
model LensProduct {
  id         String               @id @default(cuid())
  /// Internal base code without power segment (not shown in Admin UI).
  baseCode   String               @unique
  familyId   String
  baseId     String
  /// Optional — omitted from SKU/name when absent.
  materialId String?
  indexId    String
  colorId    String
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  family     LensFamily           @relation(fields: [familyId], references: [id])
  base       LensBase             @relation(fields: [baseId], references: [id])
  material   LensMaterial?        @relation(fields: [materialId], references: [id])
  index      LensIndex            @relation(fields: [indexId], references: [id])
  color      LensColor            @relation(fields: [colorId], references: [id])
  variants   LensProductVariant[]

  @@unique([familyId, baseId, materialId, indexId, colorId])
  @@index([familyId, isActive])
  @@index([baseId])
  @@index([materialId])
  @@index([isActive, updatedAt])
}

/// RC-04 sellable unit: parent + one power-range master. Own SKU, name, price, matrix.
model LensProductVariant {
  id           String         @id @default(cuid())
  productId    String
  powerRangeId String
  skuCode      String         @unique
  name         String         @unique
  rangeType    String         @default("NORMAL")
  /// Copied from power-range master for matrix UI.
  sphMin       Decimal        @db.Decimal(6, 2)
  sphMax       Decimal        @db.Decimal(6, 2)
  cylMin       Decimal        @db.Decimal(6, 2)
  cylMax       Decimal        @db.Decimal(6, 2)
  addMin       Decimal?
  addMax       Decimal?
  axis         Int?
  eye          String?
  defaultPrice Decimal?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      LensProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  powerRange   LensPowerRange @relation(fields: [powerRangeId], references: [id])

  @@unique([productId, powerRangeId])
  @@index([productId, isActive])
  @@index([powerRangeId])
  @@index([isActive, updatedAt])
}

// --- Audit & Logs (immutable; no FK cascade from business entities) ---

enum AuditActorType {
  HUMAN
  SYSTEM
  AUTOMATION
  INTEGRATION
}

enum AuditSource {
  WEB
  MOBILE
  ADMIN
  SYSTEM
  API
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Sequential public IDs for audit detail view (AU-000001).
model AuditSequence {
  id    String @id @default("default")
  value Int    @default(0)
}

/// Immutable business audit trail — insert-only via application.
model AuditEvent {
  id              String         @id @default(cuid())
  publicId        String         @unique
  occurredAt      DateTime       @default(now())
  actorType       AuditActorType @default(HUMAN)
  actorUserId     String?
  actorName       String?
  action          String
  module          String
  entityType      String
  entityId        String
  severity        AuditSeverity  @default(INFO)
  isHighRisk      Boolean        @default(false)
  source          AuditSource    @default(API)
  ipAddress       String?
  userAgent       String?
  sessionId       String?
  correlationId   String?
  clientRequestId String?
  reasonCode      String?
  reasonText      String?
  result          AuditResult    @default(SUCCESS)
  changes         Json?
  context         Json?
  relatedRefs     Json?
  message         String?

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([module, action])
  @@index([entityType, entityId, occurredAt])
  @@index([correlationId])
  @@index([isHighRisk, occurredAt])
}

/// Auth and access-control events.
model SecurityEvent {
  id            String      @id @default(cuid())
  occurredAt    DateTime    @default(now())
  action        String
  actorUserId   String?
  actorEmail    String?
  result        AuditResult @default(SUCCESS)
  source        AuditSource @default(API)
  ipAddress     String?
  userAgent     String?
  correlationId String?
  context       Json?
  message       String?

  @@index([occurredAt])
  @@index([action, occurredAt])
  @@index([actorEmail, occurredAt])
}

/// Technical failures — shorter retention than audit events.
model SystemErrorLog {
  id            String   @id @default(cuid())
  occurredAt    DateTime @default(now())
  level         String   @default("error")
  code          String?
  message       String
  route         String?
  correlationId String?
  context       Json?

  @@index([occurredAt])
  @@index([route, occurredAt])
}

/// Human-readable operational timeline.
model ActivityEvent {
  id           String   @id @default(cuid())
  occurredAt   DateTime @default(now())
  actorUserId  String?
  actorName    String?
  module       String
  entityType   String?
  entityId     String?
  message      String
  auditEventId String?

  @@index([occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
}

/// Idempotency for offline mobile replay.
model ProcessedClientRequest {
  id              String   @id @default(cuid())
  clientRequestId String   @unique
  auditEventId    String?
  createdAt       DateTime @default(now())
}

enum StockMovementType {
  RECEIVED
  SOLD
  RESERVED
  RELEASED
  ADJUSTED
  PICKED
  RESTORED
  RETURNED
  DAMAGED
  WRITTEN_OFF
}

/// General inventory movement ledger.
model StockMovement {
